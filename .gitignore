
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Shadow corpus — never commit transcripts
data/conversation_log/

# Node / npm (any subproject)
**/node_modules/
**/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — never commit secrets
**/.env
**/.env.local
**/.env.development
**/.env.development.local
**/.env.production
**/.env.production.local

# Shopify app build / runtime artifacts
**/.shopify/
**/build/
**/dist/
**/.cache/
**/.vercel/
**/prisma/dev.sqlite
**/prisma/dev.sqlite-journal
