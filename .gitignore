
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Shadow corpus — never commit transcripts
data/conversation_log/

# Node / npm (any subproject)
**/node_modules/
**/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — never commit secrets
**/.env
**/.env.local
**/.env.development
**/.env.development.local
**/.env.production
**/.env.production.local

# OAuth / credential JSONs — never commit
**/client_secret*.json
**/*credentials*.json
**/*oauth*.json
**/service-account*.json
**/service_account*.json
**/*refresh_token*.json
**/token.json

# Shopify app build / runtime artifacts
**/.shopify/
**/build/
**/dist/
**/.cache/
**/.vercel/
**/prisma/dev.sqlite
**/prisma/dev.sqlite-journal

# Next.js
**/.next/
**/.turbo/

# Python
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
*.pyc
*.pyo

# Logs / runtime
**/logs/
**/*.log
**/coverage/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

