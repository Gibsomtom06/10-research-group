# Which identity the worker sends AS. Must match the Google account that granted
# OAuth consent above. thomas@dirtysnatcha.com is a pointer/forwarder — the actual
# Google account (and thus the From: on every send) is thomas@dirtysnatcharecords.com.
SENDER_FROM_EMAIL=thomas@dirtysnatcharecords.com

# ─── Sender behavior ─────────────────────────────────────────────────────────
# First run should be dry-run=true — worker prints what it would send without
# hitting Gmail API. Flip to false once you've eyeballed 2-3 drafts.
SENDER_DRY_RUN=true

# Poll the drafts table every N ms for anything status='queued' with
# scheduled_send_at <= now. 30s is safe; we're nowhere near Gmail rate limits.
SENDER_POLL_INTERVAL_MS=30000

# Hard daily cap — Gmail will happily let you burn your reputation. We won't.
# Tour-pace safe rate for a warm personal Gmail (thomas@dirtysnatcharecords.com):
#   Week 1: 50/day (current). Week 2+ if reply rates look normal: 75/day.
#   Never exceed 100/day from a single sender without a SendGrid-class relay.
#   Gmail Workspace hard cap is 2,000/day but reputation dies far before that.
MAX_SENDS_PER_DAY=50

# Bypass the worker-local 9pm-8am gate (only affects the machine running the
# worker — per-recipient timezone quiet hours STILL fire and still defer sends
# to the promoter's local 8am). Set true for dev smoke-tests and server deploys
# (servers run 24/7 — this gate is only useful to spare a laptop at night).
SENDER_IGNORE_QUIET_HOURS=true

# ─── Email tracking (open pixel + signed click redirect) ─────────────────────
# Public base URL of the Next.js app (must be reachable from recipient inboxes).
# Local dev: use ngrok (https://xxx.ngrok.app). Prod: your real domain.
NEXT_PUBLIC_TRACK_BASE=http://localhost:3000

# 32-byte hex, HMAC-signs the click redirects so nobody can abuse us as an open
# redirector. Generated fresh for this install — keep it stable across restarts
# or existing in-flight links will fail verify. To rotate: generate new, mark
# all pending outreach_log rows as stale, accept the tracking-data loss.
TRACKING_SECRET=d9f8e79c3f32273e49466f6d6084a7fa7b718dcf4c4fb09c9cb9f9b69105268b

# ─── Optional: enable TLS / bypass for local ─────────────────────────────────
# NODE_TLS_REJECT_UNAUTHORIZED=1
