# copy to .env.local and fill in — DO NOT COMMIT .env.local

# Supabase (create project at supabase.com, copy from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only
ANTHROPIC_API_KEY=

# Model routing overrides (optional; see agents/model_config.py + PRD_model_routing.md)
# Globally override every agent's model:
# DBA_MODEL_DEFAULT=claude-sonnet-4-6
# Per-agent override (ignored for Tier-A-floor agents outbound/supervisor/research):
# DBA_MODEL_INBOUND=claude-haiku-4-5
# DBA_MODEL_ROUTING=claude-haiku-4-5
# DBA_MODEL_ANALYST=claude-haiku-4-5

# Voyage AI — embeddings (project-scoped key, Anthropic's embeddings partner)
# voyage-3-large = 1024 dims, matches schema vector(1024) column
VOYAGE_API_KEY=

# Gmail API — OAuth client for Thomas's booking inbox
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Spotify for Artists — OAuth (per-artist)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# YouTube Data API — same Google OAuth or service account
YOUTUBE_API_KEY=

# Meta Graph (Instagram Business)
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Songkick + Bandsintown
SONGKICK_API_KEY=
BANDSINTOWN_APP_ID=

# Internal admin unlock (for the /drafts approval actions)
ADMIN_PIN=
